{
  "name": "ojd-reactbits",
  "private": true,
  "description": "Composants React Bits (PromptBar, VoicePill, LatticeLoader) compilés en un bundle pour l'UI vanilla OJD.",
  "scripts": {
    "build": "esbuild src/index.jsx --bundle --minify --format=iife --target=es2020 --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --outfile=../frontend/vendor/reactbits.js"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.3",
    "@hugeicons/react": "^1.1.10",
    "motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.9"
  }
}
